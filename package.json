{
  "name": "vidcreator",
  "version": "1.0.0",
  "description": "Local video template engine & clip renderer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "setup:speech": "node scripts/setup-whisper.js base",
    "setup:youtube": "node scripts/setup-ytdlp.js",
    "icons:update": "node scripts/build-icons.js"
  },
  "keywords": ["video", "template", "ffmpeg", "clips"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "registries": {
    "@icons0": "https://icons0.dev/r/{name}.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.1",
    "uuid": "^11.1.0"
  }
}
